{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "script",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "choiceId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        }
      ]
    },
    "slot": {
      "enum": [
        "scene",
        "success",
        "failure",
        "opinion",
        "hesitation",
        "departure-warning",
        "departure",
        "absent",
        "reunion",
        "recommendation-failure",
        "infection-ending"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "opportunity"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "number"
                ]
              },
              "subject": {
                "enum": [
                  "protagonist",
                  "companion"
                ]
              },
              "stat": {
                "enum": [
                  "stress",
                  "stamina",
                  "injury",
                  "risk",
                  "cognition",
                  "affect",
                  "trust"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "kind",
              "subject",
              "stat",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "resource"
                ]
              },
              "resource": {
                "enum": [
                  "supply",
                  "medkit"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
              "kind",
              "resource",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "companion"
                ]
              },
              "present": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "present"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "weapon"
                ]
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "flag"
                ]
              },
              "flag": {
                "enum": [
                  "access",
                  "data",
                  "helpEstablished",
                  "routeKnown"
                ]
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "flag",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "fact"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "id",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "visited"
                ]
              },
              "locationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "locationId",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "location-tag"
                ]
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              }
            },
            "required": [
              "kind",
              "tag"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "stage"
                ]
              },
              "stage": {
                "enum": [
                  "early",
                  "middle",
                  "late"
                ]
              }
            },
            "required": [
              "kind",
              "stage"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0,
      "maxItems": 30
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "once": {
      "type": "boolean"
    },
    "text": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "id",
    "eventId",
    "choiceId",
    "slot",
    "conditions",
    "priority",
    "weight",
    "once",
    "text"
  ],
  "additionalProperties": false
}
