      "“차창에서 확인한 표지는 기억해 둘게. 실제 길에서도 맞는지 보자.”"
    ]
  },
  {
    "id": "local.text.115",
    "eventId": "encounter.bus-stop",
    "choiceId": "encounter.bus-stop.read-map",
    "slot": "opinion",
    "conditions": [
      {
        "kind": "companion",
