        "kind": "companion",
        "present": true
      }
    ],
    "priority": 0,
    "weight": 1,
    "once": false,
    "text": [
      "“잠깐만 생각해 보자. 나도 지금은 어느 쪽이 낫다고 말하기 어려워.”"
    ]
  },
  {
    "id": "local.text.162",
    "eventId": "encounter.gas-station",
