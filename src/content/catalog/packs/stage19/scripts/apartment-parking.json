      "말라붙은 입술을 축인다. 작은 소리까지 구분하려 하니 숨이 짧아진다."
    ]
  },
  {
    "id": "local.text.37",
    "eventId": "encounter.apartment-parking",
    "choiceId": null,
    "slot": "hesitation",
    "conditions": [
      {
        "kind": "companion",
