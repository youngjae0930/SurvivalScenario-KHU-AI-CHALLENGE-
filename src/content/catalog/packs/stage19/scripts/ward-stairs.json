    ]
  },
  {
    "id": "local.text.307",
    "eventId": "encounter.ward-stairs",
    "choiceId": "encounter.ward-stairs.wall",
    "slot": "opinion",
    "conditions": [
      {
        "kind": "companion",
        "present": true
