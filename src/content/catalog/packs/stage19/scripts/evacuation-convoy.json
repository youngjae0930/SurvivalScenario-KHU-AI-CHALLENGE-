[
  {
    "id": "local.text.721",
    "eventId": "encounter.evacuation-convoy",
    "choiceId": null,
    "slot": "scene",
    "conditions": [],
    "priority": 0,
    "weight": 1,
    "once": false,
    "text": [
      "행렬 한가운데서 비명이 터진다. 한 사람이 앞사람을 물어뜯자 뒤쪽까지 사람들이 밀려 넘어진다.",
      "“일으켜 줘요!” 바닥에 주저앉은 사람이 손을 뻗는다. 차단선은 가깝지만, 그쪽으로 바로 물러나면 이 사람을 두고 가야 한다."
    ]
  },
