[
  {
    "id": "local.text.721",
    "eventId": "encounter.evacuation-convoy",
    "choiceId": null,
    "slot": "scene",
    "conditions": [],
    "priority": 0,
    "weight": 1,
    "once": false,
    "text": [
      "행렬 한가운데의 사람이 갑자기 앞사람을 물어뜯는다. 비명과 함께 좀비의 움직임이 줄을 타고 번진다. 넘어져 일어나지 못한 사람이 손을 뻗고 있고, 차단선까지 남은 거리는 짧다."
    ]
  },
  {
    "id": "local.text.722",
